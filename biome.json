{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"includes": [
			"**",
			"!.cache",
			"!.next",
			"!.vercel",
			"!.claude",
			"!test-results",
			"!**/*.svg",
			"!src/fonts/webfonts.css"
		],
		"ignoreUnknown": true
	},
	"css": {
		"parser": {
			"cssModules": true
		}
	}
}
